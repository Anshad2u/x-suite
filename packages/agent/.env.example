# Social Maintenance Agent — Environment Configuration
# Copy this file to .env and fill in your credentials.
# DRY_RUN=true by default — no real API calls until you set it to false.

# ── X (Twitter) ──────────────────────────────────────────────────────────────
# Get these from https://developer.x.com/en/portal/dashboard
# Create an app with OAuth 1.0a (User Context) permissions.
# Set app permissions to "Read and Write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Reddit ───────────────────────────────────────────────────────────────────
# Create a "script" type app at https://www.reddit.com/prefs/apps
# The redirect URI can be http://localhost:8080 (not used for script apps).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── Telegram Alerts ──────────────────────────────────────────────────────────
# 1. Message @BotFather on Telegram, create a bot, copy the token.
# 2. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat_id.
# Missing keys = notifier disabled (other features still work).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Behavior ─────────────────────────────────────────────────────────────────
# DRY_RUN=true  → log actions, record in DB, but no real API calls.
# DRY_RUN=false → actually post / reply / send alerts.
DRY_RUN=true

# Database file path (relative to project root or absolute).
DB_PATH=social_agent.db

# Timezone for display (optional, defaults to UTC).
TZ=UTC

# ── Auto-Reply (opt-in, default off) ─────────────────────────────────────────
# Set to true to auto-reply to mentions with AUTO_REPLY_TEMPLATE.
X_AUTO_REPLY=false
REDDIT_AUTO_REPLY=false
AUTO_REPLY_TEMPLATE=Thanks for reaching out! I'll look into this.
