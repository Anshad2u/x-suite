# x-suite — consolidated environment configuration
# Copy to .env at the repo root and fill in what you need.
#
# Design note: X access is SCRAPER-ONLY (Scweet + browser cookies).
# There are deliberately no X_API_KEY / X_ACCESS_TOKEN entries — this
# project does not use the paid X API. Do not add them.

# ── X (Twitter) — scraper credentials ────────────────────────────────────────
# Log into x.com > F12 > Application > Cookies > x.com
X_AUTH_TOKEN=
CT0=
TWITTER_USERNAME=
# Optional proxy, recommended for high-volume scraping
X_PROXY=

# ── Database (Postgres only) ─────────────────────────────────────────────────
# Neon / Vercel Postgres connection string. The whole suite shares this.
POSTGRES_URL=
DATABASE_URL=

# ── API service ──────────────────────────────────────────────────────────────
# Basic-auth password for the Flask dashboard. Empty = auth disabled.
APP_PASSWORD=
# Shared secret for machine callers hitting /api/auto-post and /api/observe/run
AUTO_POST_SECRET=

# ── Posting behavior ─────────────────────────────────────────────────────────
# Daily cap. Replaces the old 480/500 monthly official-API cap, which no
# longer applies now that posting goes through the scraper.
AUTO_POST_MAX_PER_DAY=8
AUTO_POST_GROUP=Tech & AI
POST_JITTER_MIN=2
POST_JITTER_MAX=8
POST_MAX_RETRIES=3

# ── Agent behavior ───────────────────────────────────────────────────────────
# DRY_RUN=true  -> log and record, make no real posts or alerts
# DRY_RUN=false -> actually post / reply / send alerts
DRY_RUN=true
TZ=UTC
X_AUTO_REPLY=false
REDDIT_AUTO_REPLY=false
AUTO_REPLY_TEMPLATE=Thanks for reaching out! I'll look into this.

# ── Telegram alerts (empty = disabled) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── X mention watching ───────────────────────────────────────────────────────
MENTION_WATCH_LIMIT=50

# ── Reddit (official PRAW API + RSS) ─────────────────────────────────────────
# Script-type app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=
REDDIT_MENTION_LIMIT=50
REDDIT_POST_SUBREDDIT=
REDDIT_POST_MAX_PER_DAY=3
REDDIT_FEED_SUBREDDITS=
REDDIT_FEED_LIMIT=20
REDDIT_FEED_KEYWORDS=
REDDIT_FEED_DIGEST=

# Authenticated Reddit session (browser cookies) for reliable feed reads
REDDIT_SESSION_COOKIE=
REDDIT_CSRF_TOKEN=
REDDIT_TOKEN_V2=

# ── LLM (Groq) — optional, used for drafting ─────────────────────────────────
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Frontend (apps/web) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:5000
